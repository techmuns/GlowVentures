# Raw statements live in source/ and ARE committed (they are the book's provenance),
# but the expanded copies are derived — regenerate with `npm run inventory`.
source/_extracted/

# Cached NSE equity master — refetched by `npm run build-symbols`, kept out of
# the repo so a stale copy can never quietly become the authority.
scripts/.nse-equity-master.csv
scripts/.nse-sme-master.csv
scripts/.nse-etf-master.csv

# Page-check output — screenshots and report from `npm run check:pages`.
# Regenerable, and 15 full-page PNGs per run has no business in git history.
docs/page-check/

# Prepared by build:views for this exact book revision.
public/views/
src/data/readModels.json
public/publication.json

# The original statement files, copied out of source/ by build:statement-files
# for the Statement Library's preview — source/ is the committed copy.
public/statement-files/

# PDF.js resources copied from the installed, locked dependency.
public/pdf-assets/
