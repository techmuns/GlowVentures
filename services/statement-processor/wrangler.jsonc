{
  "name": "glow-statement-processor",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "containers": [{
    "class_name": "StatementProcessor",
    "image": "./Dockerfile",
    "image_build_context": "../..",
    "instance_type": "standard-2",
    "max_instances": 1
  }],
  "durable_objects": { "bindings": [{ "name": "STATEMENT_PROCESSOR", "class_name": "StatementProcessor" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StatementProcessor"] }]
}
