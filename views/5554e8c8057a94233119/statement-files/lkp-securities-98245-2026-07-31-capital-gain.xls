	try {
		parent.parent.parent.Support.document.getElementById('LodingBar').style.display='none';
	} catch (error) {
	}
	try
	{
		var Setvar = false;
		for (var j = 0; j <document.forms.length; j++) 
		{
					
					var input = document.createElement("input");
					input.setAttribute("type", "hidden");
					input.setAttribute("name", "SQtr");
					input.setAttribute("id", "SQtr");
					input.setAttribute("value", "false");
					document.forms[j].appendChild(input);
					var inputs =  document.forms[j].elements;   
					for (var i = 0; i < inputs.length; i++) 
					{   
						
						  if (inputs[i].type == "button" || inputs[i].type == "submit") 
						  { 
						
							if(inputs[i].value.toUpperCase() == "SAVE" 
								|| inputs[i].value.toUpperCase() == "UPDATE"
								|| inputs[i].value.toUpperCase() == "DELETE"
								|| inputs[i].value.toUpperCase() == "AUTHORISE"
								|| inputs[i].value.toUpperCase() == "REJECT"
								|| inputs[i].value.toUpperCase() == "ADD"
								|| inputs[i].value.toUpperCase() == "CONFORM"
								|| inputs[i].value.toUpperCase() == "CONTINUE"
								|| inputs[i].name.toUpperCase() == "CONTINUE"
								|| inputs[i].value.toUpperCase() == "SUBMIT"
								|| inputs[i].name.toUpperCase() == "CMDSUBMIT"
								|| inputs[i].name.toUpperCase() == "SAVE"
								|| inputs[i].name.toUpperCase() == "UPDATE"
								|| inputs[i].name.toUpperCase() == "DELETE"
								|| inputs[i].name.toUpperCase() == "ADD"
								|| inputs[i].name.toUpperCase() == "CONFORM"
								|| inputs[i].name.toUpperCase() == "SUBMIT"
								
							)
							{
									var Setvar = true;
									break;
							}
						  }
						 
					}
		}
		if(  Setvar)
		{			
				
					var xhttp = new XMLHttpRequest();
				    xhttp.onreadystatechange = function() {
					if (xhttp.readyState == 4 && xhttp.status == 200) {
						
							document.forms[0].SQtr.value =Setvar;
							var input = document.createElement("input");
							input.setAttribute("type", "hidden");
							input.setAttribute("name", "SecurityCSRStoken");
							input.setAttribute("id", "SecurityCSRStoken");
							input.setAttribute("value", xhttp.responseText);
							document.forms[0].appendChild(input);
					}
				  };
				  xhttp.open("GET", "/focaps/GetToken.cfm", true);
				  xhttp.send();
		}	
	}
	catch(e)
	{}
	</script>
<script language="javascript">
				function BlackListreq(e) {
						if(e.which != null && e.which != 13 && e.which != 0)
						{
								var regex = new RegExp("^[a-zA-Z0-9: %&* )(@+-/\\_.,]+$");
								var str = String.fromCharCode(!e.charCode ? e.which : e.charCode);
								if (!regex.test(str)) {	
									alert('Charectore Is Allowed')
									return false;
								}
						}
					}
					function CheckAllreq()
						{
							
							var inputs =  document.forms[0].elements;   
							for (var i = 0; i < inputs.length; i++) 
							{   
							  if (inputs[i].type == "text" || inputs[i].type == "textarea") 
							  {   
										if(inputs[i].id =='');
											inputs[i].id =inputs[i].name
										$('#'+inputs[i].name).keypress(BlackListreq);
										
							  }
							  if (inputs[i].type == "button" && (inputs[i].value ==' V ' || inputs[i].value =='V' )) 
							  {   
								inputs[i].style.display ='none';
							  }   
							} 
						}
</script>
<script language="javascript">
						(function(){
							
